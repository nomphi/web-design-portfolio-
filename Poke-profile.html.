<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Poké Profile</title>

<style>
:root {
    --yellow: #ffcb05;
    --blue: #2864b4;
    --red: #e63946;
    --dark: #18243a;
    --white: #ffffff;
    --muted: #718096;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f6fa;
    color: var(--dark);
    min-height: 100vh;
    padding: 35px 16px;
}

.page {
    max-width: 760px;
    margin: auto;
}

/* HEADER */

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    font-size: 21px;
    letter-spacing: -1px;
}

.pokeball {
    width: 34px;
    height: 34px;
    border: 3px solid var(--dark);
    border-radius: 50%;
    background: linear-gradient(
        to bottom,
        var(--red) 0 45%,
        var(--dark) 45% 55%,
        var(--white) 55% 100%
    );
    position: relative;
}

.pokeball::after {
    content: "";
    width: 9px;
    height: 9px;
    background: var(--white);
    border: 3px solid var(--dark);
    border-radius: 50%;
    position: absolute;
    top: 9px;
    left: 9px;
}

.status {
    background: #e4f7e9;
    color: #218344;
    padding: 8px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
}

/* PROFILE CARD */

.profile-card {
    background: var(--white);
    border: 2px solid var(--dark);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 7px 7px 0 var(--dark);
}

.card-header {
    background: var(--yellow);
    padding: 24px;
    border-bottom: 2px solid var(--dark);
    position: relative;
}

.card-header::after {
    content: "POKÉMON TRAINER PROFILE";
    position: absolute;
    right: 18px;
    bottom: 12px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.5px;
    opacity: 0.65;
}

.label {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.identity {
    padding: 28px 24px 24px;
}

.name-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 7px;
}

.name {
    font-size: clamp(27px, 6vw, 39px);
    font-weight: 900;
    letter-spacing: -1.5px;
}

.badge {
    background: var(--blue);
    color: white;
    padding: 6px 9px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: bold;
}

.handle {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 19px;
}

.bio {
    font-size: 14px;
    line-height: 1.8;
    max-width: 500px;
    margin-bottom: 23px;
}

.buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

button {
    padding: 12px 20px;
    border: 2px solid var(--dark);
    border-radius: 8px;
    font-weight: 800;
    cursor: pointer;
    font-size: 12px;
    transition: transform 0.2s, box-shadow 0.2s;
}

button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--dark);
}

.follow-btn {
    background: var(--blue);
    color: white;
}

.message-btn {
    background: white;
    color: var(--dark);
}

/* INFORMATION */

.section {
    border-top: 2px solid #e9edf3;
    padding: 23px 24px;
}

.section-title {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
}

.section-title span {
    background: var(--yellow);
    width: 23px;
    height: 23px;
    border-radius: 6px;
    display: grid;
    place-items: center;
    font-size: 13px;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.info-box {
    background: #f4f6fa;
    padding: 15px 12px;
    border-radius: 10px;
    border: 1px solid #e2e7ef;
}

.info-label {
    display: block;
    color: var(--muted);
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 9px;
}

.info-value {
    font-size: 13px;
    font-weight: 800;
    overflow-wrap: anywhere;
}

/* INTERESTS */

.interests {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
}

.tag {
    border: 1px solid #dce3ed;
    background: white;
    padding: 9px 12px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: bold;
}

.tag:nth-child(3n + 1) {
    border-bottom: 3px solid var(--yellow);
}

.tag:nth-child(3n + 2) {
    border-bottom: 3px solid var(--blue);
}

.tag:nth-child(3n) {
    border-bottom: 3px solid var(--red);
}

/* FOOTER */

.card-footer {
    background: var(--dark);
    color: white;
    padding: 17px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 1px;
    font-weight: bold;
}

.footer-mark {
    color: var(--yellow);
}

/* MOBILE */

@media (max-width: 500px) {
    body {
        padding: 22px 14px;
    }

    .card-header {
        padding: 20px;
    }

    .identity {
        padding: 24px 18px;
    }

    .section {
        padding: 21px 18px;
    }

    .info-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .card-footer {
        padding: 16px 18px;
        flex-wrap: wrap;
    }
}
</style>
</head>

<body>

<div class="page">

    <header class="topbar">
        <div class="logo">
            <div class="pokeball"></div>
            <span>POKÉ<span style="color:#2864b4">PROFILE</span></span>
        </div>

        <div class="status">● TRAINER ONLINE</div>
    </header>

    <main class="profile-card">

        <div class="card-header">
            <div class="label">Trainer ID · 000001</div>
        </div>

        <section class="identity">

            <div class="name-row">
                <h1 class="name">Your Name</h1>
                <span class="badge">✦ TRAINER</span>
            </div>

            <p class="handle">@yourusername</p>

            <p class="bio">
                Pokémon enthusiast. Exploring new worlds, collecting
                memories, and becoming the very best at what I do.
            </p>

            <div class="buttons">
                <button class="follow-btn" id="followBtn">＋ Follow</button>
                <button class="message-btn" id="messageBtn">✉ Message</button>
            </div>

        </section>

        <section class="section">

            <h2 class="section-title">
                <span>◈</span> TRAINER INFORMATION
            </h2>

            <div class="info-grid">

                <div class="info-box">
                    <span class="info-label">Age</span>
                    <span class="info-value">Your age</span>
                </div>

                <div class="info-box">
                    <span class="info-label">Gender</span>
                    <span class="info-value">Not specified</span>
                </div>

                <div class="info-box">
                    <span class="info-label">Location</span>
                    <span class="info-value">Your location</span>
                </div>

                <div class="info-box">
                    <span class="info-label">Joined</span>
                    <span class="info-value">Jan 2026</span>
                </div>

                <div class="info-box">
                    <span class="info-label">Favorite Type</span>
                    <span class="info-value">Electric ⚡</span>
                </div>

                <div class="info-box">
                    <span class="info-label">Trainer Rank</span>
                    <span class="info-value">Rookie</span>
                </div>

            </div>

        </section>

        <section class="section">

            <h2 class="section-title">
                <span>★</span> INTERESTS
            </h2>

            <div class="interests">
                <span class="tag">Pokémon</span>
                <span class="tag">Gaming</span>
                <span class="tag">Anime</span>
                <span class="tag">Music</span>
                <span class="tag">Adventure</span>
            </div>

        </section>

        <footer class="card-footer">
            <span>POKÉ PROFILE SYSTEM</span>
            <span class="footer-mark">GOTTA CATCH 'EM ALL.</span>
        </footer>

    </main>

</div>

<script>
const followBtn = document.getElementById("followBtn");
const messageBtn = document.getElementById("messageBtn");

let following = false;

followBtn.addEventListener("click", function () {
    following = !following;

    if (following) {
        followBtn.textContent = "✓ Following";
    } else {
        followBtn.textContent = "＋ Follow";
    }
});

messageBtn.addEventListener("click", function () {
    alert("🥺 It's just a sample, loser!");
});
</script>

</body>
</html>
